plugin.tx_ns_friendlycaptcha {
  # cat=plugin.friendlycaptcha//03; type=string; label= Site key
  public_key =

  # cat=plugin.friendlycaptcha//04; type=string; label= Secret key
  secret_key =

  # cat=plugin.friendlycaptcha//08; type=options[Auto check,Check on Focus,Manual]; label= Automization options
  autocheck = auto

  # cat=plugin.friendlycaptcha//09; type=boolean; label= Enable EU endpoint
  eu = 0

  # cat=plugin.friendlycaptcha//10; type=boolean; label= Enable puzzle
  enablepuzzle = 0

  # cat=plugin.friendlycaptcha//11; type=boolean; label= Enforce captcha in development mode
  enforceCaptcha = 0

  # cat=plugin.friendlycaptcha//12; type=boolean; label= Robot mode for automated testing
  robotMode = 0
}
